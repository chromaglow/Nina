---
import { Image } from 'astro:assets';
import { type CollectionEntry } from 'astro:content';

type Props = { project: CollectionEntry<'projects'>; class?: string; headingLevel?: 'h2' | 'h3' };

const { project, class: className, headingLevel = 'h2' } = Astro.props;
const { title, medium, year, seo } = project.data;
const TitleTag = headingLevel;
const image = seo?.image;
---

<a class:list={['group block', className]} href={`/projects/${project.id}/`}>
    {image?.src && (
        <div class="overflow-hidden mb-3 bg-muted aspect-[4/3]">
            <Image
                src={image.src}
                alt={image.alt ?? title}
                width={600}
                height={450}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
        </div>
    )}
    <TitleTag class="font-serif text-lg leading-tight font-medium group-hover:underline group-hover:decoration-dashed group-hover:decoration-1 group-hover:underline-offset-4">
        {title}
    </TitleTag>
    {(medium || year) && (
        <div class="mt-1 text-sm opacity-60">{[medium, year].filter(Boolean).join(' · ')}</div>
    )}
</a>
